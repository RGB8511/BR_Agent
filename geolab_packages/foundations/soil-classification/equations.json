[
  {
    "id": "geotechnical.foundations.soil-classification.eq-001",
    "title": "Coefficient of Uniformity",
    "equation": "C_u = D_60 / D_10",
    "variables": {
      "C_u": {"description": "Coefficient of uniformity", "units": "dimensionless"},
      "D_60": {"description": "Grain diameter at 60% passing", "units": "mm"},
      "D_10": {"description": "Grain diameter at 10% passing (effective size)", "units": "mm"}
    },
    "applicability": "Coarse-grained soils — USCS gradation classification",
    "criteria": {
      "well_graded_gravel": "C_u >= 4 AND 1 <= C_c <= 3",
      "well_graded_sand": "C_u >= 6 AND 1 <= C_c <= 3"
    },
    "source": "ASTM D2487",
    "chunk_type": "equation"
  },
  {
    "id": "geotechnical.foundations.soil-classification.eq-002",
    "title": "Coefficient of Curvature",
    "equation": "C_c = (D_30)^2 / (D_10 × D_60)",
    "variables": {
      "C_c": {"description": "Coefficient of curvature (coefficient of gradation)", "units": "dimensionless"},
      "D_30": {"description": "Grain diameter at 30% passing", "units": "mm"},
