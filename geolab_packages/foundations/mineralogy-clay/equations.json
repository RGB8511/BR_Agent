    },
    "source": "Terzaghi (1944), Skempton & Northey (1952)"
  },
  {
    "id": "geotechnical.foundations.mineralogy-clay.eq-002",
    "title": "Percent Sodium (Dispersivity Indicator)",
    "equation": "PS = Na⁺ / (Na⁺ + K⁺ + Ca²⁺ + Mg²⁺) × 100",
    "variables": {
      "PS": {"description": "Percent sodium in pore water extract", "units": "%"},
