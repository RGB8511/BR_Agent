  {
    "id": "remote-sensing.change-detection.tbl-001",
    "title": "Change Detection Method Selection",
    "type": "classification",
    "data": {
      "headers": ["Method", "Input Data", "Output", "Strengths", "Limitations"],
      "rows": [
        ["DEM of Difference (DoD)", "Gridded DEMs (any source)", "Raster of ΔZ + volume", "Simple, widely understood, volume calculation direct", "Vertical only; interpolation artifacts; grid resolution limits detail"],
        ["M3C2 (Cloud-to-Cloud)", "Raw point clouds", "Signed distance + confidence per point", "No gridding; statistical LOD; handles rough surfaces", "Computationally intensive; requires good normal estimation"],
        ["C2C (nearest neighbor)", "Raw point clouds", "Unsigned distance per point", "Fast; simple; good for screening", "No sign (erosion vs deposition); sensitive to density variation"],
        ["Image correlation (PIV/DIC)", "Ortho-imagery", "2D horizontal displacement vectors", "Full-field displacement; high spatial resolution", "No vertical component; needs good texture; illumination-sensitive"],
        ["ICP-based rigid body", "Point cloud subsets", "3D translation + rotation vectors", "Full 6-DOF movement of rigid objects (blocks, structures)", "Assumes rigid body; needs identifiable segments"],
        ["Feature tracking", "Multi-epoch imagery or clouds", "Discrete displacement vectors at features", "Tracks specific objects/points; intuitive", "Sparse measurement; feature identification needed"]
      ]
    },
    "source": "Lague et al. (2013), Wheaton et al. (2010), general practice"
  },
  {
