    "id": "geotechnical.foundations.mineralogy-clay.eq-001",
    "title": "Sensitivity",
    "equation": "S_t = s_u(undisturbed) / s_u(remolded)",
    "variables": {
      "S_t": {"description": "Sensitivity", "units": "dimensionless"},
