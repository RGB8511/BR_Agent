# Database — matches docker-compose.yml defaults
DATABASE_URL=postgresql://geolab:geolab@localhost:5432/geolab_kb
GEOLAB_DATABASE_URL=postgresql://geolab:geolab@localhost:5432/geolab_kb

# Anthropic API key — required for chat agent and query expansion
GEOLAB_ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# Voyage AI API key — required for embeddings
VOYAGE_API_KEY=pa-YOUR_KEY_HERE
GEOLAB_VOYAGE_API_KEY=pa-YOUR_KEY_HERE
