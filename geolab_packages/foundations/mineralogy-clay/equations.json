  },
  {
    "id": "geotechnical.foundations.mineralogy-clay.eq-003",
    "title": "Double Hydrometer Dispersion Ratio",
    "equation": "DR = (% finer than 5 μm without dispersant) / (% finer than 5 μm with dispersant) × 100",
