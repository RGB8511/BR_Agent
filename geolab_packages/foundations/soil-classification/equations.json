      "D_60": {"description": "Grain diameter at 60% passing", "units": "mm"}
    },
    "applicability": "Coarse-grained soils — must satisfy 1 ≤ C_c ≤ 3 for well-graded classification",
    "source": "ASTM D2487",
    "chunk_type": "equation"
  },
  {
    "id": "geotechnical.foundations.soil-classification.eq-003",
    "title": "Casagrande A-Line",
    "equation": "PI = 0.73 × (LL - 20)",
    "variables": {
      "PI": {"description": "Plasticity index", "units": "%"},
      "LL": {"description": "Liquid limit", "units": "%"}
    },
    "applicability": "Plasticity chart boundary separating clay (above) from silt (below). Valid for LL > 20.",
    "source": "Casagrande (1948), ASTM D2487",
    "chunk_type": "equation"
  },
  {
    "id": "geotechnical.foundations.soil-classification.eq-004",
    "title": "U-Line (Upper Bound)",
    "equation": "PI = 0.9 × (LL - 8)",
    "variables": {
      "PI": {"description": "Plasticity index", "units": "%"},
      "LL": {"description": "Liquid limit", "units": "%"}
