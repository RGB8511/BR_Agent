[
  {
    "id": "geotechnical.soil-mechanics.permeability-seepage.eq-001",
    "title": "Darcy's Law",
    "equation": "q = k × i × A",
    "alt_form": "v = k × i = k × (Δh / L)",
    "variables": {
      "q": {"description": "Volumetric flow rate", "units": "m³/s"},
      "k": {"description": "Hydraulic conductivity", "units": "m/s or cm/s"},
      "i": {"description": "Hydraulic gradient (dimensionless)", "units": "Δh/L"},
      "A": {"description": "Cross-sectional area of flow", "units": "m²"},
      "v": {"description": "Discharge velocity (superficial velocity)", "units": "m/s"}
    },
    "applicability": "Laminar flow through saturated porous media. Valid for Re < ~1–10.",
    "source": "Darcy (1856)"
  },
  {
    "id": "geotechnical.soil-mechanics.permeability-seepage.eq-002",
    "title": "Seepage Velocity",
    "equation": "v_s = v / n = k × i / n",
    "variables": {
      "v_s": {"description": "Seepage velocity (actual velocity through pores)", "units": "m/s"},
      "v": {"description": "Discharge velocity", "units": "m/s"},
      "n": {"description": "Porosity", "units": "dimensionless"}
    },
    "source": "Derived from Darcy's law"
  },
  {
    "id": "geotechnical.soil-mechanics.permeability-seepage.eq-003",
    "title": "Hazen's Equation",
    "equation": "k = C × D₁₀²",
    "variables": {
      "k": {"description": "Hydraulic conductivity", "units": "cm/s"},
      "C": {"description": "Hazen's constant (0.4–1.5, commonly 1.0)", "units": "1/(cm·s)"},
      "D₁₀": {"description": "Effective grain size (10% passing)", "units": "cm"}
    },
    "applicability": "Clean, uniformly graded sands. 0.1 mm < D₁₀ < 3 mm, Cu < 5.",
    "source": "Hazen (1892)"
  },
  {
    "id": "geotechnical.soil-mechanics.permeability-seepage.eq-004",
    "title": "Kozeny-Carman Equation",
    "equation": "k = (γ_w / μ) × [1 / (C_k × S_s²)] × [e³ / (1 + e)]",
    "variables": {
      "k": {"description": "Hydraulic conductivity", "units": "m/s"},
      "γ_w": {"description": "Unit weight of water", "units": "N/m³"},
      "μ": {"description": "Dynamic viscosity of water", "units": "Pa·s"},
      "C_k": {"description": "Kozeny constant (~5 for uniform spheres)", "units": "dimensionless"},
      "S_s": {"description": "Specific surface area per unit volume of solids", "units": "1/m"},
      "e": {"description": "Void ratio", "units": "dimensionless"}
    },
    "applicability": "Not valid for clays (double-layer effects) or very coarse/open materials.",
    "source": "Kozeny (1927), Carman (1938, 1956)"
  },
  {
    "id": "geotechnical.soil-mechanics.permeability-seepage.eq-005",
    "title": "Temperature Correction for k",
    "equation": "k₂₀ = k_T × (μ_T / μ₂₀)",
    "variables": {
      "k₂₀": {"description": "Hydraulic conductivity corrected to 20°C", "units": "cm/s"},
      "k_T": {"description": "Hydraulic conductivity at test temperature T", "units": "cm/s"},
      "μ_T": {"description": "Viscosity of water at temperature T", "units": "Pa·s"},
      "μ₂₀": {"description": "Viscosity of water at 20°C (1.002 × 10⁻³ Pa·s)", "units": "Pa·s"}
    },
    "source": "Standard correction per ASTM D2434"
  },
  {
    "id": "geotechnical.soil-mechanics.permeability-seepage.eq-006",
    "title": "Constant-Head Permeability Test",
    "equation": "k = (Q × L) / (A × h × t)",
    "variables": {
      "k": {"description": "Hydraulic conductivity", "units": "cm/s"},
      "Q": {"description": "Volume of water collected", "units": "cm³"},
      "L": {"description": "Length of specimen", "units": "cm"},
      "A": {"description": "Cross-sectional area", "units": "cm²"},
      "h": {"description": "Head difference", "units": "cm"},
      "t": {"description": "Time of collection", "units": "s"}
    },
    "applicability": "Coarse-grained soils (k > ~10⁻⁴ cm/s). ASTM D2434.",
    "source": "ASTM D2434"
  },
  {
    "id": "geotechnical.soil-mechanics.permeability-seepage.eq-007",
    "title": "Falling-Head Permeability Test",
    "equation": "k = (a × L) / (A × t) × ln(h₁/h₂)",
    "variables": {
      "k": {"description": "Hydraulic conductivity", "units": "cm/s"},
      "a": {"description": "Cross-sectional area of standpipe", "units": "cm²"},
      "L": {"description": "Length of specimen", "units": "cm"},
      "A": {"description": "Cross-sectional area of specimen", "units": "cm²"},
      "t": {"description": "Elapsed time", "units": "s"},
      "h₁": {"description": "Initial head in standpipe", "units": "cm"},
      "h₂": {"description": "Final head in standpipe", "units": "cm"}
    },
    "applicability": "Fine-grained soils (k < ~10⁻⁴ cm/s). Also flexible-wall permeameter (D5084).",
    "source": "Standard falling-head derivation"
  },
  {
    "id": "geotechnical.soil-mechanics.permeability-seepage.eq-008",
    "title": "Equivalent Horizontal Permeability (Parallel Layers)",
    "equation": "k_h(eq) = Σ(k_i × H_i) / Σ(H_i)",
    "variables": {
      "k_h(eq)": {"description": "Equivalent horizontal permeability", "units": "m/s"},
      "k_i": {"description": "Permeability of layer i", "units": "m/s"},
      "H_i": {"description": "Thickness of layer i", "units": "m"}
    },
    "applicability": "Weighted average. Dominated by most permeable layer.",
    "source": "Derived from parallel flow assumption"
  },
  {
    "id": "geotechnical.soil-mechanics.permeability-seepage.eq-009",
    "title": "Equivalent Vertical Permeability (Series Layers)",
    "equation": "k_v(eq) = Σ(H_i) / Σ(H_i / k_i)",
    "variables": {
      "k_v(eq)": {"description": "Equivalent vertical permeability", "units": "m/s"},
      "k_i": {"description": "Permeability of layer i", "units": "m/s"},
      "H_i": {"description": "Thickness of layer i", "units": "m"}
    },
    "applicability": "Harmonic average. Dominated by least permeable layer. Always k_v ≤ k_h.",
    "source": "Derived from series flow assumption"
  },
  {
    "id": "geotechnical.soil-mechanics.permeability-seepage.eq-010",
    "title": "Flow Net Seepage Quantity",
    "equation": "q = k × H × (N_f / N_d)",
    "variables": {
      "q": {"description": "Seepage flow rate per unit length", "units": "m³/s/m"},
      "k": {"description": "Hydraulic conductivity", "units": "m/s"},
      "H": {"description": "Total head loss across flow domain", "units": "m"},
      "N_f": {"description": "Number of flow channels", "units": "count"},
      "N_d": {"description": "Number of equipotential drops", "units": "count"}
    },
    "applicability": "2D steady-state flow through homogeneous, isotropic medium. For anisotropic soil, transform section.",
    "source": "Cedergren (1989)"
  },
  {
    "id": "geotechnical.soil-mechanics.permeability-seepage.eq-011",
    "title": "Seepage Force Per Unit Volume",
    "equation": "j = γ_w × i",
    "variables": {
      "j": {"description": "Seepage force per unit volume of soil", "units": "kN/m³"},
      "γ_w": {"description": "Unit weight of water", "units": "kN/m³"},
      "i": {"description": "Hydraulic gradient", "units": "dimensionless"}
    },
    "source": "Terzaghi (1943)"
  },
  {
    "id": "geotechnical.soil-mechanics.permeability-seepage.eq-012",
    "title": "Critical Hydraulic Gradient",
    "equation": "i_cr = (G_s - 1) / (1 + e) = γ' / γ_w",
    "variables": {
      "i_cr": {"description": "Critical hydraulic gradient for quick condition", "units": "dimensionless"},
      "G_s": {"description": "Specific gravity of solids", "units": "dimensionless"},
      "e": {"description": "Void ratio", "units": "dimensionless"},
      "γ'": {"description": "Submerged unit weight", "units": "kN/m³"}
    },
    "applicability": "Upward seepage. Effective stress → 0 when i = i_cr. Typical i_cr ≈ 0.9–1.1 for sands.",
    "source": "Terzaghi (1943)"
  },
  {
    "id": "geotechnical.soil-mechanics.permeability-seepage.eq-013",
    "title": "Factor of Safety Against Piping",
    "equation": "FS = i_cr / i_exit",
    "variables": {
      "FS": {"description": "Factor of safety", "units": "dimensionless"},
      "i_cr": {"description": "Critical gradient", "units": "dimensionless"},
      "i_exit": {"description": "Exit gradient at downstream toe", "units": "dimensionless"}
    },
    "applicability": "FS ≥ 3–5 for dam foundations. Read i_exit from flow net as Δh/(Δs at exit).",
    "source": "USACE, USBR practice"
  },
  {
    "id": "geotechnical.soil-mechanics.permeability-seepage.eq-014",
    "title": "Transformed Section for Anisotropic Seepage",
    "equation": "x_t = x × √(k_v / k_h)",
    "variables": {
      "x_t": {"description": "Transformed horizontal dimension", "units": "m"},
      "x": {"description": "Original horizontal dimension", "units": "m"},
      "k_v": {"description": "Vertical hydraulic conductivity", "units": "m/s"},
      "k_h": {"description": "Horizontal hydraulic conductivity", "units": "m/s"}
    },
    "applicability": "Draw flow net on transformed section (squeezed horizontally). Use k_eq = √(k_h × k_v) for seepage calculation.",
    "source": "Cedergren (1989)"
  }
]
