    "source": "Houlsby (1976), Ewert (1997), USBR DS-13"
  },
  {
    "id": "field-exploration.in-situ-permeability.tbl-002",
    "title": "Houlsby Packer Test Flow Pattern Interpretation",
    "type": "classification",
    "data": {
      "headers": ["Pattern", "Ascending Steps", "Descending Steps", "Interpretation", "Action"],
      "rows": [
        ["Laminar", "Q ∝ P (linear)", "Same as ascending", "Darcy flow through fractures; valid Lugeon", "Standard calculation valid"],
        ["Turbulent", "Q less than ∝ P", "Same as ascending", "High flow velocity in fractures; Darcy not valid", "Use low-pressure steps for Lugeon; overestimates at high P"],
        ["Dilation", "Low Q at low P; rapid increase at high P", "Descending Q > ascending Q", "Fractures opening under pressure (hydrojacking)", "Report onset pressure; reduce max pressure; Lugeon from low P only"],
        ["Washout", "Increasing Q with time at each step", "Desc > ascending (progressive)", "Joint infill being eroded by water flow", "Not a reliable permeability; indicates erodible infill; grouting concern"],
        ["Void filling", "Decreasing Q with time at each step", "Desc < ascending", "Voids being filled with water; not reaching steady state", "Not a permeability test; indicates large voids; extend test time"]
      ]
    },
    "source": "Houlsby (1976), Quiñones-Rozo (2010)"
  },
