    "title": "Achievable Change Detection Precision by Platform/Method",
    "type": "design_criteria",
    "data": {
      "headers": ["Platform", "Method", "Typical LOD (m)", "Volume Accuracy", "Notes"],
      "rows": [
        ["Terrestrial LiDAR (TLS)", "M3C2 or DoD", "0.002–0.010", "±1–3%", "Best precision; limited range/coverage"],
        ["UAS photogrammetry (RTK)", "DoD", "0.015–0.050", "±2–5%", "Good balance of coverage and precision"],
        ["UAS LiDAR", "DoD or M3C2", "0.010–0.030", "±2–4%", "Better in vegetation than photogrammetry"],
        ["Airborne LiDAR", "DoD", "0.050–0.150", "±5–10%", "Large area; lower precision per point"],
        ["Satellite stereo (Pléiades, WV)", "DoD", "0.30–1.0", "±10–20%", "Very large area; low precision"],
        ["InSAR (PS-InSAR)", "Time series displacement", "0.001–0.003 (LOS)", "N/A (1D displacement)", "Best for slow, mm-scale movements"],
        ["Ground-based InSAR", "Displacement map", "0.001–0.010 (LOS)", "N/A", "High temporal frequency; range-dependent"]
      ]
    },
    "source": "Various — Lague (2013), Wheaton (2010), Crosetto (2016)"
  },
  {
    "id": "remote-sensing.change-detection.tbl-003",
    "title": "Common Error Sources in Multi-Epoch Comparison",
    "type": "reference",
    "data": {
      "headers": ["Error Source", "Magnitude", "Mitigation"],
      "rows": [
        ["Registration/alignment error", "1–50 mm (TLS), 20–100 mm (UAS)", "Permanent ground control; stable reference surfaces; ICP on unchanged areas"],
        ["Coordinate system/datum mismatch", "Centimeters to meters", "Use same datum, geoid model, and projection for all epochs"],
        ["Point density variation", "Increases noise in sparse areas", "Set minimum density threshold; increase LOD in sparse zones"],
        ["Vegetation/temporal change", "0.01–5 m", "Classify and remove vegetation; use ground-only points; bare-earth filter"],
        ["Wet/dry surface (photogrammetry)", "5–20 mm apparent change", "Consistent surface conditions or LiDAR (not affected)"],
        ["Shadow/illumination (photogrammetry)", "5–50 mm noise increase", "Consistent lighting; avoid harsh shadows; overcast preferred"],
        ["Interpolation artifacts (DoD)", "Depends on grid size", "Use grid size ≤ 2× mean point spacing; triangulate rather than grid when possible"],
        ["Systematic tilt/drift", "mm to cm across site", "Check-point analysis; detrend stable areas; robust GCP network"]
      ]
    },
    "source": "General best practice, Lague et al. (2013), James & Robson (2014)"
  },
