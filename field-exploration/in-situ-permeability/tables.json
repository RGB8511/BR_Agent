    "type": "classification",
    "data": {
      "headers": ["Lugeon Value", "Permeability Class", "Approx K (m/s)", "Dam Foundation Significance"],
      "rows": [
        ["< 1", "Very low / tight", "< 1.3×10⁻⁷", "Acceptable — no treatment needed"],
