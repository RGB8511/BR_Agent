      "rows": [
        ["Insufficient borehole cleaning", "Artificially high N (driving through cuttings/slough)", "Clean to bottom before each test; use proper drilling technique"],
        ["Water level in borehole below groundwater", "Artificially low N (piping/loosening of sand at bottom)", "Maintain water/mud level at or above groundwater level"],
        ["Short hammer drop", "Artificially high N", "Use automatic hammer; verify drop height"],
        ["Damaged sampler (dented, bent)", "Artificially high N", "Inspect sampler before every test"],
        ["Borehole too large", "Artificially low N (stress relief around hole)", "Use standard borehole diameter (65–115 mm)"],
        ["Anvil/rod energy losses", "Reduced energy → higher N", "Measure energy (ASTM D4633); use corrections"],
        ["Not seating sampler on undisturbed soil", "Variable — depends on condition", "Clean hole thoroughly; note if seating drive is abnormal"],
        ["Gravel particles (false refusal)", "N appears much higher than matrix soil", "Note as refusal on gravel; use CPT or pressuremeter instead"],
