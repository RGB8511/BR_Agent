    "title": "Surface Geophysical Method Selection Guide",
    "type": "classification",
    "data": {
      "headers": ["Target / Objective", "Primary Method(s)", "Supporting Method(s)", "Limitations"],
      "rows": [
        ["Depth to bedrock", "Seismic refraction", "ERI, MASW", "Refraction needs velocity increase; fails with weathered rock gradient"],
        ["Vs30 / seismic site class", "MASW", "Downhole seismic (borehole)", "Active MASW limited to ~30 m; passive extends deeper"],
        ["Soft/weak soil zones", "MASW (low Vs zones)", "ERI (low resistivity if clay)", "Requires sufficient contrast"],
        ["Groundwater table", "Seismic refraction (Vp jump)", "ERI, GPR (in coarse soils)", "Refraction: table must be flat; GPR fails in clay"],
        ["Clay thickness / extent", "ERI (low resistivity)", "EM (quick reconnaissance)", "Equivalence problem — thick/thin clay can give same response"],
        ["Karst / voids / sinkholes", "ERI + microgravity", "GPR (if shallow & in resistive ground)", "Small voids at depth may not be detectable"],
        ["Contamination plume", "ERI (conductive plume)", "EM reconnaissance", "LNAPL may be resistive; DNAPL complex"],
        ["Buried utilities / tanks", "GPR", "EM (metal detection), magnetics", "GPR fails in clay; EM detects only metallic objects"],
        ["Rippability assessment", "Seismic refraction (Vp)", "—", "Correlations are equipment-specific"],
        ["Dam / levee seepage", "ERI (time-lapse)", "Self-potential (SP)", "Requires repeated surveys or steady-state contrast"],
        ["Landslide investigation", "ERI (slip surface, water)", "MASW (Vs contrast), seismic refraction", "Complex 3D geometry may need multiple 2D lines"],
        ["Fault / fracture mapping", "ERI, seismic refraction/reflection", "GPR (shallow, in resistive ground)", "Requires sufficient offset and contrast across fault"]
      ]
    },
    "source": "FHWA GEC-5, Anderson & Croxton (2008), USACE EM 1110-1-1802"
  },
