        ["3–10", "Moderate", "4×10⁻⁷ to 1.3×10⁻⁶", "Grouting recommended for dam foundations"],
        ["10–30", "High", "1.3×10⁻⁶ to 4×10⁻⁶", "Significant seepage; grouting essential"],
        ["30–100", "Very high", "4×10⁻⁶ to 1.3×10⁻⁵", "Open fractures; heavy grouting or treatment required"],
        ["> 100", "Extremely high", "> 1.3×10⁻⁵", "Cavernous or highly fractured; special treatment needed"]
